! Small FODO ring used by the tao-gui tests.
parameter[geometry] = closed
beginning[beta_a] = 10
beginning[beta_b] = 10
parameter[particle] = electron
parameter[e_tot] = 1e9

qf: quadrupole, l = 0.5, k1 = 0.3
qd: quadrupole, l = 0.5, k1 = -0.3
d: drift, l = 2.0
b: sbend, l = 2.0, angle = pi/8

cell: line = (qf, d, b, d, qd, d, b, d)
ring: line = (8*cell)
use, ring
